<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}{% if title != site.name %} — {{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="{% if not indexable or noindex %}noindex, nofollow{% else %}index, follow, max-image-preview:large{% endif %}">
  <meta name="theme-color" content="#eeeae2">
  <link rel="canonical" href="{{ page.url | absolute(siteUrl) }}">
  <link rel="icon" href="{{ '/assets/favicon.svg' | asset }}" type="image/svg+xml">
  <link rel="icon" href="{{ '/assets/favicon-32.png' | asset }}" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="{{ '/assets/apple-touch-icon.png' | asset }}" sizes="180x180">
  <link rel="manifest" href="{{ '/site.webmanifest' | asset }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }} — {{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ page.url | absolute(siteUrl) }}">
  <meta property="og:image" content="{{ (socialImage or '/assets/images/social.jpg') | absolute(siteUrl) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Stolen Tribe — Stories without borders. Independent TV & film content studio.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} — {{ site.name }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ (socialImage or '/assets/images/social.jpg') | absolute(siteUrl) }}">
  <link rel="preload" href="{{ '/assets/fonts/anton.woff2' | asset }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/manrope.woff2' | asset }}" as="font" type="font/woff2" crossorigin>
  {% if home %}<link rel="preload" href="{{ site.hero.image | asset }}" as="image" fetchpriority="high">{% endif %}
  <link rel="stylesheet" href="{{ '/assets/styles.css' | asset }}">
  <script src="{{ '/assets/site.js' | asset }}" defer></script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "Organization", "@id": "{{ '/' | absolute(siteUrl) }}#organization", "name": {{ site.name | json | safe }}, "legalName": {{ site.legalName | json | safe }}, "url": "{{ '/' | absolute(siteUrl) }}", "logo": "{{ '/assets/logo.svg' | absolute(siteUrl) }}", "description": {{ site.description | json | safe }}, "email": {{ site.email | json | safe }}, "telephone": {{ site.phone | json | safe }}, "address": { "@type": "PostalAddress", "addressLocality": "Jersey City", "addressRegion": "NJ", "postalCode": "07304", "addressCountry": "US" }, "sameAs": [{{ site.instagram | json | safe }}, {{ site.linkedin | json | safe }}] },
      { "@type": "WebSite", "@id": "{{ '/' | absolute(siteUrl) }}#website", "url": "{{ '/' | absolute(siteUrl) }}", "name": {{ site.name | json | safe }}, "publisher": { "@id": "{{ '/' | absolute(siteUrl) }}#organization" } },
      { "@type": "{% if contact %}ContactPage{% elif studio %}AboutPage{% else %}WebPage{% endif %}", "@id": "{{ page.url | absolute(siteUrl) }}#webpage", "url": "{{ page.url | absolute(siteUrl) }}", "name": {{ title | json | safe }}, "description": {{ (description or site.description) | json | safe }}, "isPartOf": { "@id": "{{ '/' | absolute(siteUrl) }}#website" } }
    ]
  }
  </script>
</head>
<body class="{% if home %}page-home{% endif %}{% if contact %} page-contact{% endif %}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% include 'header.njk' %}
  <main id="main">{{ content | safe }}</main>
  {% include 'footer.njk' %}
  <dialog class="film-dialog" id="film-dialog" aria-labelledby="film-title">
    <div class="film-dialog-bar"><div><span class="eyebrow">Now playing</span><h2 id="film-title">Studio film</h2></div><button class="film-close" type="button" aria-label="Close film">Close <span aria-hidden="true">×</span></button></div>
    <div class="film-player" id="film-player"></div>
    <div class="film-dialog-caption"><p id="film-note"></p><a id="film-external" href="https://vimeo.com/1100394104/823ccd916b" target="_blank" rel="noopener noreferrer">Open video in a new tab ↗</a></div>
  </dialog>
</body>
</html>
